{% extends 'base.html.twig' %}

{% block title %}Job "{{ job.summary.id }}"{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1 style="display:inline;">Job "{{ job.summary.id }}"</h1>

    <form method="get" action="{{ path('dashboard') }}" style="display:inline; margin-left: 6px; vertical-align: super;">
        <input type="submit" value="Dashboard">
    </form>

    <form method="get" action="{{ path('suites') }}" style="display:inline; margin-left: 6px; vertical-align: super;">
        <input type="submit" value="Suites">
    </form>

    <form method="get" action="{{ path('suite_view', {id: job.summary.suiteId}) }}" style="display:inline; margin-left: 6px; vertical-align: super;">
        <input type="submit" value="Suite {{ job.summary.suiteId }}">
    </form>

    <form method="post" action="{{ path('log_out_handle') }}" style="display:inline; margin-left: 6px; vertical-align: super;">
        <input type="submit" value="Log out">
    </form>

    <h2>Job "{{ job.summary.id }}"</h2>

    <h3>Meta state</h3>
    <ul>
        <li>Ended: {{ job.metaState.ended ? 'true' : 'false' }}</li>
        <li>Succeeded: {{ job.metaState.succeeded ? 'true' : 'false' }}</li>
    </ul>

    {% if job.metaState == ended_failed_metastate %}
        <h3>Component Failures</h3>

        {% for name, component in job.components.filterByMetaState(ended_failed_metastate) %}
            <p><strong>{{ name }}</strong></p>

            {% if 'machine' == name %}
                {% if null !== component.actionFailure %}
                    <ul>
                        <li>action: {{ component.actionFailure.action }}</li>
                        <li>type: {{ component.actionFailure.type }}</li>
                        <li>Context:
                            <pre style="font-size: 0.8rem">{{ component.actionFailure.context|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                        </li>
                    </ul>
                {% endif %}
            {% endif %}
        {% endfor %}
    {% endif %}

    <h3>Summary</h3>

    <p id="summary_created_at">Created: {{ job.summary.createdAt.format('c') }}</p>
    <p id="summary_suite_id">Suite: <a href="{{ path('suite_view', {id: job.summary.suiteId}) }}">{{ job.summary.suiteId }}</a></p>
    <p id="summary_maximum_duration">Maximum duration (in seconds): {{ job.summary.maximumDurationInSeconds }}</p>

    <h3>Events: {{ events | length }}</h3>

    {% if results_job.hasEvents %}
        <ol>
            {% for event in events %}
                <li >
                    <p>Type: {{ event.type }}</p>

                    {% if 'job/started' == event.type %}
                        <p>Job: {{event.jobMetadata.label }}</p>

                        <p>Tests:</p>

                        <ul>
                            {% for test in event.testMetadataCollection %}
                                <li>{{ test.name }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}

                    {% if
                        'lifecycle/compilation-started' == event.type or
                        'lifecycle/compilation-completed' == event.type or
                        'lifecycle/execution-started' == event.type or
                        'lifecycle/execution-completed' == event.type
                    %}
                        <p>Job: {{ event.jobMetadata.label }}</p>
                    {% endif %}

                    {% if 'compilation/started' == event.type %}
                        <p>Test: {{ event.testMetadata.name }}</p>
                    {% endif %}

                    {% if 'compilation/passed' == event.type %}
                        <p>Test: {{ event.testMetadata.name }}</p>
                        <p>Steps:</p>

                        <ul>
                            {% for step in event.stepMetadataCollection %}
                                <li>"{{ step.name }}"</li>
                            {% endfor %}
                        </ul>
                    {% endif %}

                    {% if 'test/started' == event.type %}
                        <p>Test: {{ event.testMetadata.name }}</p>

                        <p>Configuration:</p>
                        <ul>
                            <li>Browser: {{ event.configuration.browser }}</li>
                            <li>URL: {{ event.configuration.url }}</li>
                        </ul>

                        <p>Steps:</p>
                        <ul>
                            {% for step in event.stepMetadataCollection %}
                                <li>"{{ step.name }}"</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    {% endif %}

    <h3>Preparation: {{ job.preparation.state }}</h3>

    <h3>Results Job</h3>
    <ul>
        <li>Ended: {{ results_job.metaState.ended ? 'true' : 'false' }}</li>
        <li>Succeeded: {{ results_job.metaState.succeeded ? 'true' : 'false' }}</li>
        <li>State: {{ results_job.state }}</li>
        <li>End state: {{ results_job.endState ?? 'none' }}</li>
        <li>Has events: {{ results_job.hasEvents ? 'true' : 'false' }}</li>
    </ul>

    <h4>Preparation: {{ results_job.preparation.state }}</h4>
    {% if null !== results_job.preparation.failure %}
        <ul>
            <li>type: {{ results_job.preparation.failure.type }}</li>
            <li>type: {{ results_job.preparation.failure.code }}</li>
            <li>type: {{ results_job.preparation.failure.message }}</li>
        </ul>
    {% endif %}

    <h4>Service requests:</h4>
    <ul>
        {% for request in results_job.serviceRequests %}
            <li>
                <p>type: {{ request.type }}</p>
                <ul>
                    {% for attempt in request.attempts %}
                        <li>{{ attempt.state }}</li>
                    {% endfor %}
                </ul>
            </li>
        {% endfor %}
    </ul>

    <h3>Serialized Suite</h3>
    <ul>
        <li>Ended: {{ serialized_suite.metaState.ended ? 'true' : 'false' }}</li>
        <li>Succeeded: {{ serialized_suite.metaState.succeeded ? 'true' : 'false' }}</li>
        <li>State: {{ serialized_suite.state }}</li>
    </ul>

    <h4>Preparation: {{ serialized_suite.preparation.state }}</h4>
    {% if null !== serialized_suite.preparation.failure %}
        <ul>
            <li>type: {{ serialized_suite.preparation.failure.type }}</li>
            <li>type: {{ serialized_suite.preparation.failure.code }}</li>
            <li>type: {{ serialized_suite.preparation.failure.message }}</li>
        </ul>
    {% endif %}

    <h4>Service requests:</h4>
    <ul>
        {% for request in serialized_suite.serviceRequests %}
            <li>
                <p>type: {{ request.type }}</p>
                <ul>
                    {% for attempt in request.attempts %}
                        <li>{{ attempt.state }}</li>
                    {% endfor %}
                </ul>
            </li>
        {% endfor %}
    </ul>

    <h3>Machine</h3>
    <ul>
        <li>Ended: {{ machine.metaState.ended ? 'true' : 'false' }}</li>
        <li>Succeeded: {{ machine.metaState.succeeded ? 'true' : 'false' }}</li>
        <li>State: {{ machine.stateCategory }}</li>
        <li>IP address: {{ machine.ipAddress ?? 'none' }}</li>
    </ul>

    <h4>Preparation: {{ machine.preparation.state }}</h4>
    {% if null !== machine.preparation.failure %}
        <ul>
            <li>type: {{ machine.preparation.failure.type }}</li>
            <li>type: {{ machine.preparation.failure.code }}</li>
            <li>type: {{ machine.preparation.failure.message }}</li>
        </ul>
    {% endif %}

    <h4>Service requests:</h4>
    <ul>
        {% for request in machine.serviceRequests %}
            <li>
                <p>type: {{ request.type }}</p>
                <ul>
                    {% for attempt in request.attempts %}
                        <li>{{ attempt.state }}</li>
                    {% endfor %}
                </ul>
            </li>
        {% endfor %}
    </ul>

    <h3>Worker Job</h3>
    <ul>
        <li>Ended: {{ worker_job.metaState.ended ? 'true' : 'false' }}</li>
        <li>Succeeded: {{ worker_job.metaState.succeeded ? 'true' : 'false' }}</li>
        <li>State: {{ worker_job.state }}</li>
        <li>Component states:
            <pre style="font-size: 0.8rem">{{ worker_job.componentStates |json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
        </li>
    </ul>

    <h4>Preparation: {{ worker_job.preparation.state }}</h4>
    {% if null !== worker_job.preparation.failure %}
        <ul>
            <li>type: {{ worker_job.preparation.failure.type }}</li>

            {% if 'application' != worker_job.preparation.failure.type %}
                <li>code: {{ worker_job.preparation.failure.code }}</li>
            {% endif %}

            <li>message: {{ worker_job.preparation.failure.message }}</li>
        </ul>

        {% if 'application' == worker_job.preparation.failure.type %}

            {% if 'worker-job:source/manifest/empty' == worker_job.preparation.failure.message %}
                <p>Unable to create worker job; suite manifest was empty.</p>
            {% endif %}

            {% if 'worker-job:source/manifest/invalid' == worker_job.preparation.failure.message %}
                <p>Unable to create worker job; suite manifest contained invalid YAML.</p>
            {% endif %}

            {% if 'worker-job:source/manifest/empty_test_path_collection' == worker_job.preparation.failure.message %}
                <p>Unable to create worker job; suite manifest provides no tests to run.</p>
            {% endif %}

            {% if 'worker-job:source/manifest/unknown' == worker_job.preparation.failure.message %}
                <p>Unable to create worker job; suite manifest was not accepted for an unknown reason.</p>
            {% endif %}

        {% endif %}

    {% endif %}

    <h4>Service requests:</h4>
    <ul>
        {% for request in worker_job.serviceRequests %}
            <li>
                <p>type: {{ request.type }}</p>
                <ul>
                    {% for attempt in request.attempts %}
                        <li>{{ attempt.state }}</li>
                    {% endfor %}
                </ul>
            </li>
        {% endfor %}
    </ul>
</div>
{% endblock %}
