{% extends 'base.html.twig' %}

{% block title %}Job "{{ job.summary.id }}"{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1 style="display:inline;">Job "{{ job.summary.id }}"</h1>

    <form method="get" action="{{ path('dashboard') }}" style="display:inline; margin-left: 6px; vertical-align: super;">
        <input type="submit" value="Dashboard">
    </form>

    <form method="get" action="{{ path('suites') }}" style="display:inline; margin-left: 6px; vertical-align: super;">
        <input type="submit" value="Suites">
    </form>

    <form method="get" action="{{ path('suite_view', {id: job.summary.suiteId}) }}" style="display:inline; margin-left: 6px; vertical-align: super;">
        <input type="submit" value="Suite {{ job.summary.suiteId }}">
    </form>

    <form method="post" action="{{ path('log_out_handle') }}" style="display:inline; margin-left: 6px; vertical-align: super;">
        <input type="submit" value="Log out">
    </form>

    <h2>Job "{{ job.summary.id }}"</h2>

    <h3>Meta state</h3>
    <ul>
        <li>Ended: {{ job.metaState.ended ? 'true' : 'false' }}</li>
        <li>Succeeded: {{ job.metaState.succeeded ? 'true' : 'false' }}</li>
    </ul>

    {% if job.metaState == ended_failed_metastate %}
        <h3>Component Failures</h3>

        {% for name, component in job.components.filterByMetaState(ended_failed_metastate) %}
            <p><strong>{{ name }}</strong></p>

            {% if 'machine' == name %}
                {% if null !== component.actionFailure %}
                    <ul>
                        <li>action: {{ component.actionFailure.action }}</li>
                        <li>type: {{ component.actionFailure.type }}</li>
                    </ul>
                {% endif %}
            {% endif %}
        {% endfor %}
    {% endif %}

    <h3>Summary</h3>

    <p id="summary_created_at">Created: {{ job.summary.createdAt.format('c') }}</p>
    <p id="summary_suite_id">Suite: <a href="{{ path('suite_view', {id: job.summary.suiteId}) }}">{{ job.summary.suiteId }}</a></p>
    <p id="summary_maximum_duration">Maximum duration (in seconds): {{ job.summary.maximumDurationInSeconds }}</p>

    <h3>Preparation: {{ job.preparation.state }}</h3>
    <p>Service requests:</p>
    <ul>
        {% for name, state in job.preparation.requestStates %}
        <li>
            {{ name }}: {{ state }}
        </li>
        {% endfor %}
    </ul>

    <h3>Results Job</h3>

    {% if null == results_job %}
        <p>Awaiting ...</p>
    {% else %}
        <ul>
            <li>Ended: {{ results_job.metaState.ended ? 'true' : 'false' }}</li>
            <li>Succeeded: {{ results_job.metaState.succeeded ? 'true' : 'false' }}</li>
            <li>State: {{ results_job.state }}</li>
            <li>End state: {{ results_job.endState ?? 'none' }}</li>
        </ul>
    {% endif %}

    <h3>Serialized Suite</h3>

    {% if null == serialized_suite %}
        <p>Awaiting ...</p>
    {% else %}
        <ul>
            <li>Ended: {{ serialized_suite.metaState.ended ? 'true' : 'false' }}</li>
            <li>Succeeded: {{ serialized_suite.metaState.succeeded ? 'true' : 'false' }}</li>
            <li>State: {{ serialized_suite.state }}</li>
        </ul>
    {% endif %}

    <h3>Machine</h3>

    {% if null == machine %}
        <p>Awaiting ...</p>
    {% else %}
        <ul>
            <li>Ended: {{ machine.metaState.ended ? 'true' : 'false' }}</li>
            <li>Succeeded: {{ machine.metaState.succeeded ? 'true' : 'false' }}</li>
            <li>State: {{ machine.stateCategory }}</li>
            <li>IP address: {{ machine.ipAddress ?? 'none' }}</li>
        </ul>
    {% endif %}

    <h3>Worker Job</h3>

    {% if null == worker_job %}
        <p>Awaiting ...</p>
    {% else %}
        <ul>
            <li>Ended: {{ worker_job.metaState.ended ? 'true' : 'false' }}</li>
            <li>Succeeded: {{ worker_job.metaState.succeeded ? 'true' : 'false' }}</li>
            <li>State: {{ worker_job.state }}</li>
            <li>Component states:
                <pre style="font-size: 0.8rem">{{ worker_job.componentStates |json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
            </li>
        </ul>
    {% endif %}
</div>
{% endblock %}
